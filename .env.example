# Salin file ini menjadi .env lalu isi nilainya. JANGAN commit file .env.

# Kunci acak panjang untuk menandatangani cookie sesi.
# Buat dengan: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Supabase (Project Settings -> API). Kosongkan keduanya untuk memakai
# database SQLite lokal saat pengembangan.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
